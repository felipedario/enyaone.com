---
interface Props {
  action?: string;
  placeholder?: string;
  buttonText?: string;
}

const {
  action = "https://www.google.com/search",
  placeholder = "Search Enya lyrics, discography...",
  buttonText = "Search"
} = Astro.props;
---

<form action={action} method="get" target="_blank" rel="noopener" class="search-form">
  <input type="hidden" name="sitesearch" value="enya.one" />
  <label for="search-input" class="sr-only">Search</label>
  <input
    type="text"
    id="search-input"
    name="q"
    placeholder={placeholder}
    required
  />
  <button type="submit">{buttonText}</button>
</form>

<style>
  .search-form {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .search-form input[type="text"] {
    flex: 1;
    padding: 0.5rem;
    font-size: 0.95rem;
    border: 1px solid #ccc;
    border-radius: 4px;
  }
  .search-form button {
    padding: 0.5rem 1rem;
    font-size: 0.95rem;
    background-color: #333;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }
  .search-form button:hover {
    background-color: #555;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
