---
import enya2023Adwr from '../assets/enya-2023-adwr.jpg';
import enya2023Tmot from '../assets/enya-2023-tmot.jpg';

import '@fontsource/alegreya';
import '@fontsource/lato';
import '../styles/style-enya-lyrics.css';
import { Image } from 'astro:assets';

import alegreya400 from '@fontsource/alegreya/files/alegreya-latin-400-normal.woff2?url';
import lato400 from '@fontsource/lato/files/lato-latin-400-normal.woff2?url';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	ogImageWidth?: number | string;
	ogImageHeight?: number | string;
	bodyClass?: string;
	schemaJson?: Record<string, any> | Array<Record<string, any>>;
}

const {
	title = "Enya songs, albums, biography, lyrics, and more!",
	description = "Enya Lyrics is a tribute to singer Enya featuring all her song lyrics, downloads, Only Time info, albums information, videos, biography and more!",
	canonical,
	ogImage = "https://www.enyaone.com/enya-promo.jpg",
	ogImageWidth,
	ogImageHeight,
	bodyClass = "",
	schemaJson
} = Astro.props;

const currentYear = new Date().getFullYear();

const defaultWebsiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "Enya One",
	"url": "https://www.enyaone.com/",
	"description": description,
	"publisher": {
		"@type": "Person",
		"name": "Enya",
		"alternateName": "Eithne Pádraigín Ní Bhraonáin"
	}
};

const schemasToRender = schemaJson ? (Array.isArray(schemaJson) ? schemaJson : [schemaJson]) : [defaultWebsiteSchema];
---

<!DOCTYPE html>
<html lang="en">
<head>
	<script
  type="text/partytown"
  async
  src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6820018585261081"
  crossorigin="anonymous">
</script>
<script type="text/partytown">
  window.amzn_assoc_ad_type = "link_enhancement_widget";
  window.amzn_assoc_tracking_id = "enylyrallenys-20";
  window.amzn_assoc_linkid = "37185a8c74e87935464f4661e194da1c";
  window.amzn_assoc_placement = "";
  window.amzn_assoc_marketplace = "amazon";
  window.amzn_assoc_region = "US";
</script>
<script
  type="text/partytown"
  src="https://ws-na.amazon-adsystem.com/widgets/q?ServiceVersion=20070822&Operation=GetScript&ID=OneJS&WS=1&MarketPlace=US">
</script>
<script
  type="text/partytown"
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-DGJ1308PT5">
</script>
<script type="text/partytown">
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', 'G-DGJ1308PT5');
</script>

<link rel="preload" href={alegreya400} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={lato400} as="font" type="font/woff2" crossorigin />
<link rel="preconnect" href="https://fundingchoicesmessages.google.com">

	<meta charset="utf-8">
	<meta http-equiv="x-ua-compatible" content="ie=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>{title}</title>

	<meta name="description" content={description} />

	{canonical && <link rel="canonical" href={canonical} />}

	<meta itemprop="name" content={title}>
	<meta itemprop="description" content={description}>
	<meta itemprop="image" content={ogImage}>

	{ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)}>}
	{ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)}>}
	<meta property="og:description" content={description}>
	<meta property="og:title" content={title}>
	{canonical && <meta property="og:url" content={canonical}>}
	<meta property="og:image" content={ogImage}>

	<meta name="twitter:card" content="summary">
	<meta name="twitter:title" content={title}>
	<meta name="twitter:description" content={description}>
	<meta name="twitter:image:src" content={ogImage}>

	<meta content="Felipe Dario (https://felipedario.com)" name="author" />

	{schemasToRender.map((schema) => (
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	))}
</head>
<body class={bodyClass}>
	<a href="#main" class="sr">Jump to content</a>

	<div id="wrap">
		<header>
			<div id="logo"><a href="/" title="Enya Lyrics main page">Enya One: Enya songs, albums, biography, lyrics, and more!</a></div>

			<nav id="menu" aria-label="Main navigation">
				<ul>
					<li class="drop"><a href="/enya-songs-albums" title="Albums and lyrics list" id="sm">Songs, Albums &amp; Lyrics</a>
						<ul>
							<li><a href="/enya-album"><em>Enya</em>, 1987</a></li>
							<li><a href="/watermark"><em>Watermark</em>, 1988</a></li>
							<li><a href="/shepherd-moons"><em>Shepherd Moons</em>, 1991</a></li>
							<li><a href="/the-celts"><em>The Celts</em>, 1992</a></li>
							<li><a href="/the-memory-of-trees"><em>The Memory of Trees</em>, 1995</a></li>
							<li><a href="/paint-the-sky-with-stars"><em>Paint The Sky With Stars</em>, 1997</a></li>
							<li><a href="/a-day-without-rain"><em>A Day Without Rain</em>, 2000</a></li>
							<li><a href="/enya-amarantine"><em>Amarantine</em>, 2005</a></li>
							<li><a href="/and-winter-came"><em>And Winter Came</em>, 2008</a></li>
							<li><a href="/very-best-enya"><em>The Very Best of Enya</em>, 2009</a></li>
							<li><a href="/enya-dark-sky-island"><em>Dark Sky Island</em>, 2015</a></li>
							<li><a href="/enya-other">Other songs by Enya</a></li>
							<li><a href="/all-enya-songs">List of all songs</a></li>
						</ul>
					</li>
					<li><a href="/enya-biography" title="Enya biography">Biography</a></li>
					<li><a href="/new-age-music" title="New Age music">Artists like Enya</a></li>
					<li><a href="/enya-video" title="EnyaTube Enya videos">Videos</a></li>
					<li><a href="/sitemap" title="More about Enya">More <span class="sr">about Enya: sitemap</span></a></li>
				</ul>
			</nav>

		</header>

		<section id="content">

		<main id="main">

		<slot />

		</main>

		<aside id="sidebar">
				
				<h2>Featured albums</h2>

				<h3><em><a href="/a-day-without-rain">A Day Without Rain</a></em>, 2000</h3>
				
				<div><a href="/a-day-without-rain">
					<Image src={enya2023Adwr} alt="A Day Without Rain album picture"  width="300" height="300" /></a>
					
					<p>Through extensive use in various forms of media, "Only Time" became an anthem of resilience and hope after  the tragic events of the September 11 attacks. </p>
				</div>

				<h3><em><a href="/the-memory-of-trees">The Memory of Trees</a></em>, 1995</h3>
				
				<div><a href="/the-memory-of-trees">
					<Image src={enya2023Tmot} alt="The Memory of Trees album picture" width="300" height="300" /></a>
					
					<p>This album won Enya's first Grammy Award for Best New Age Album. &ldquo;With the destruction of the world&rsquo;s rainforests it may turn out to be that the memory of trees is nothing more than that for us&mdash;a memory.&rdquo;</p>
				</div>
				
			</aside>

			</section>

		
