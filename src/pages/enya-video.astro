---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";

const title = "Enya music videos, live performances | Enya Lyrics, MP3 downloads";
const description = "EnyaTube is your Enya videos resource. Watch her official music videos collection and live performances!";
const canonical = "https://www.enyaone.com/enya-video";
const ogImage = "https://www.enyaone.com/enya-promo.jpg";
const bodyClass = "video-home";

const schemaJson = {
	"@context": "https://schema.org",
	"@type": "VideoObject",
	"name": title,
	"description": description
};
---

<Layout {title} {description} {canonical} {ogImage} {bodyClass} {schemaJson}>

