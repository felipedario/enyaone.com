---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";

const title = "Enya — Christmas Carols from Cork (December 2016) live performance video";
const description = "Enya — Christmas Carols from Cork (December 2016). Enya Lyrics is a tribute to the New Age singer Enya featuring all her song lyrics, MP3 downloads, Only Time info, discography, news, videos, quotes, biography and more!";
const canonical = "https://www.enyaone.com/enya-live-christmas";
const ogImage = "https://www.enyaone.com/enya-promo.jpg";
const bodyClass = "";

const schemaJson = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"name": title,
	"description": description
};
---

<Layout {title} {description} {canonical} {ogImage} {bodyClass} {schemaJson}>
  <div id="content">


    <main id="main">
      <h1>Enya — Christmas Carols from Cork <small>(December 2016)</small></h1>

<div class="ads-2016">
<script async src="//pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
<!-- EnyaLyrics2016 Responsivo -->
<ins class="adsbygoogle"
     style="display:block"
     data-ad-client="ca-pub-6820018585261081"
     data-ad-slot="6987262141"
     data-ad-format="auto"></ins>
<script>
(adsbygoogle = window.adsbygoogle || []).push({});
</script>
</div>

<div id="video-screen">

<iframe width="1050" height="591" src="https://www.youtube-nocookie.com/embed/oJ2pKJRkR7E" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>

</div>

