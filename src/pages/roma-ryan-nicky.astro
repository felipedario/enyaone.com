---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";

const title = "Roma Ryan & Nicky Ryan | The Enya Creative Trio";
const description = "Learn more about Roma Ryan, Enya's lyricist, and Nicky Ryan, her late producer and sound engineer, who together created the iconic Enya sound.";
const canonical = "https://www.enyaone.com/roma-ryan-nicky";
const ogImage = "https://www.enyaone.com/roma-ryan.jpg";
const bodyClass = "roma-nicky-page";

const schemaJson = {
	"@context": "https://schema.org",
	"@type": "AboutPage",
	"name": title,
	"description": description,
  "mainEntity": [
    {
      "@type": "Person",
      "name": "Roma Ryan",
      "jobTitle": "Lyricist & Author"
    },
    {
      "@type": "Person",
      "name": "Nicky Ryan",
      "jobTitle": "Music Producer & Sound Engineer"
    }
  ]
};
---

<Layout {title} {description} {canonical} {ogImage} {bodyClass} {schemaJson}>
  <div id="content">
    <nav aria-label="Breadcrumb">
      <ol id="breadcrumb">
        <li><a href="/">Home</a> &rsaquo;</li>
        <li><strong>Roma &amp; Nicky Ryan</strong></li>
      </ol></nav> </nav>

    <main id="main" class="creative-trio">
      <h1>Roma Ryan &amp; Nicky Ryan</h1>

      <h2>The Enya Creative Trio</h2>

      <p>The distinctive sound of Enya is not created by a single artist alone, but by a collaborative trio consisting of Enya, lyricist Roma Ryan, and producer Nicky Ryan.</p>

      <h2>Nicky Ryan</h2>
      <p>Nicky Ryan was Enya's long-time manager, producer, and sound engineer. He pioneered the technique of multi-tracking Enya's vocals hundreds of times to create her signature ethereal choir effect.</p>

      <h2>Roma Ryan</h2>
      <p>Roma Ryan is Enya's lyricist and primary literary partner. She writes lyrics for Enya in various languages including English, Irish, Latin, Spanish, and created the fictional language Loxian.</p>
    </main>

    <Sidebar />
  </div>
</Layout>
