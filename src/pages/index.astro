---
import enyaHome from "../assets/enya_home.jpg";
import celticWoman from "../assets/cw_home.jpg";

import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

const title = "Enya songs, albums, biography, lyrics, and more!";
const description =
	"Enya Lyrics is a tribute to singer Enya featuring all her song lyrics, downloads, Only Time info, albums information, videos, biography and more!";
const canonical = "https://www.enyaone.com/";
const ogImage = "https://www.enyaone.com/enya-promo.jpg";
const bodyClass = "";

const schemaJson = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: title,
	description: description,
};
---

<Layout {title} {description} {canonical} {ogImage} {bodyClass} {schemaJson}>
	<h1>Enya songs, albums, biography...</h1>

	<p class="desc">
		<strong>Welcome to Enya One!</strong> Explore Enya's <a
			href="/enya-songs-albums/">song lyrics, translations</a
		>, <a href="/enya-songs-albums/">albums</a>, <a href="/enya-video/"
			>videos</a
		>, and <a href="/enya-biography/">biography</a>.
	</p>

	<ul class="feature-cards">
		<li>
			<a href="/enya-songs-albums/"
				><strong>Discography</strong> Discover all songs, albums, and lyrics.</a
			>
		</li>
		<li>
			<a href="/enya-biography/"
				><strong>Biography</strong> Gain a deeper understanding of Enya's
				career and life.</a
			>
		</li>
		<li>
			<a href="/enya-biography/#faq"
				><strong>FAQs</strong> Find answers to frequently asked questions.</a
			>
		</li>
		<li>
			<a href="/new-age-music/"
				><strong>Explore the genre</strong> Discover more artists like Enya:
				New Age, celtic artists with similar ethereal or ambient styles.</a
			>
		</li>
	</ul>
	

	<h2><em>Even more about</em> Enya</h2>

	<ul class="feature-cards">
		<li>
			<a href="/all-enya-songs/"><strong>Stream Enya's Music</strong> Explore a complete list of Enya's
				songs available for streaming and download.</a>
		</li>
		<li>
			<a href="/roma-ryan-nicky/"
				><strong>Creative Collaborators</strong> Roma Ryan and the late Nicky
				Ryan contributed significantly to Enya's music, writing and producing
				captivating compositions.</a>
		</li>
		<li>
			<a href="/enya-clannad/"
				><strong>Family Ties</strong> Clannad a renowned band formed by Enya's
				family including Moya Brennan, influenced Enya's musical journey.</a>
		</li>
		<li>
			<a href="/enya-video/"><strong>Multimedia</strong> Watch music videos and live performances.</a
			>
		</li>
	</ul>

	<h2 id="About_Enya">Who is Enya?</h2>

	<div style="overflow: hidden;">

	<a
		target="_blank"
		href="https://link.amazon/B05wk5lWY"
		><Image
			src={enyaHome}
			alt="Stream or download Enya songs"
			class="float-left width-33 rounded"
			width="300"
			height="300"
		/></a
	>

	<p>
		<a href="/enya-biography/"><strong>Enya</strong></a> is a Grammy Award Irish
		singer, often labeled as “New Age”. Singing and playing all instruments by
		herself, she made world hits such as “<a
			href="/a-day-without-rain/#Only_Time">Only Time</a
		>”, “<a href="/enya-other/#May_It_Be">May It Be</a>” and “<a
			href="/watermark/#Orinoco_Flow">Orinoco Flow (Sail Away)</a
		>”.</p>

		<a href="/enya-biography/" class="btn-primary"
			><strong>More about Enya &raquo;</strong></a
		>

	</div>


	<h2>Discover artists like Enya</h2>

	<div>

	<a
		target="_blank"
		href="https://link.amazon/A0eAPlD1V"
		><Image
			src={celticWoman}
			alt="Stream or download Celtic Woman songs"
			class="float-left width-33 rounded"
			width="300"
			height="300"
		/></a
	>

	<p><a href="/new-age-music/">Celtic Woman</a>, <a
			href="/new-age-music/">Clannad</a
		> (Enya's family band), <a href="/new-age-music/">Loreena McKennitt</a>, <a
			href="/new-age-music/">Vangelis</a
		> and <a href="/new-age-music/">Yanni</a>, just to name a few.
	</p>

	<a href="/new-age-music/" class="btn-primary"
			><strong>More artists like Enya &raquo;</strong></a
		>

	</div>

</Layout>
