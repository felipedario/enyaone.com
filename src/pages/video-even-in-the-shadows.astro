---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";

const title = "Enya's Even In The Shadows music video | All Enya videos";
const description = "Video for Enya song Even In The Shadows. Enya Lyrics is a tribute to the New Age singer Enya featuring all her song lyrics, MP3 downloads, Only Time info, discography, news, videos, quotes, biography and more!";
const canonical = "https://www.enyaone.com/video-even-in-the-shadows";
const ogImage = "https://www.enyaone.com/enya-promo.jpg";
const bodyClass = "";

const schemaJson = {
	"@context": "https://schema.org",
	"@type": "VideoObject",
	"name": title,
	"description": description
};
---

<Layout {title} {description} {canonical} {ogImage} {bodyClass} {schemaJson}>

      <h1>Even In The Shadows, 2015</h1>

<div id="video-screen">

<iframe width="1050" height="591" src="https://www.youtube-nocookie.com/embed/2e8iRKReYPo" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>

</div>

<h3>About</h3>
<p>Released in November 2015, this is the video for Enya song <a href="/enya-dark-sky-island/#Even_In_The_Shadows">"Even In The Shadows"</a>, the fourth from her new album <a href="/enya-dark-sky-island/"><em>Dark Sky Island</em></a>.</p>
<p>Time: 4:14</p>

<p>"Even in the Shadows" features a double bass played by Irish rock and jazz musician Eddie Lee. Lee was a member of Those Nervous Animals from Sligo, Ireland who were label mates, under the Tara Music label, of the Brennan family band Clannad in the 1980s; Enya was a member of Clannad from 1980 to 1982.</p>

<p><strong><a href="/enya-video/">&laquo; EnyaTube home</a></strong></p>

</Layout>
