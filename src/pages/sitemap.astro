---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";

const title = "Sitemap: more about Enya and site information";
const description = "Enya Lyrics is a tribute to the New Age singer Enya featuring all her song lyrics, MP3 downloads, Only Time info, discography, news, videos, quotes, biography and more!";
const canonical = "https://www.enyaone.com/sitemap";
const ogImage = "https://www.enyaone.com/enya-promo.jpg";
const bodyClass = "";

const schemaJson = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"name": title,
	"description": description
};
---

<Layout {title} {description} {canonical} {ogImage} {bodyClass} {schemaJson}>

