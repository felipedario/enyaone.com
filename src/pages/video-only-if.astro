---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";

const title = "Enya's Only If... music video | All Enya videos, live performances";
const description = "Video for Enya song Only If... Enya Lyrics is a tribute to the New Age singer Enya featuring all her song lyrics, MP3 downloads, Only Time info, discography, news, videos, quotes, biography and more!";
const canonical = "https://www.enyaone.com/video-only-if";
const ogImage = "https://www.enyaone.com/enya-promo.jpg";
const bodyClass = "";

const schemaJson = {
	"@context": "https://schema.org",
	"@type": "VideoObject",
	"name": title,
	"description": description
};
---

<Layout {title} {description} {canonical} {ogImage} {bodyClass} {schemaJson}>
  <div id="content">


    <main id="main">
      <h1>Only If..., 1997 <small>Directed by Dan Nathan</small></h1>

<div class="ads-2016">
<script async src="//pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
<!-- EnyaLyrics2016 Responsivo -->
<ins class="adsbygoogle"
     style="display:block"
