---
import Layout from "../layouts/Layout.astro";
import albumsData from "../data/albums.json";

const title = "Enya's full album list in order, movie soundtracks | Enya One";
const description = "All information on Enya's songs, albums and more. Enya Lyrics is a tribute to the New Age singer Enya featuring all her song lyrics, MP3 downloads, Only Time info, albums, news, videos, quotes, biography and more!";
const canonical = "https://www.enyaone.com/enya-songs-albums";
const ogImage = "https://www.enyaone.com/enya-promo.jpg";
const bodyClass = "discography-page";

const mainAlbums = albumsData.filter((a) => a.type === "studio" || a.type === "compilation");
const soundtrackAlbums = albumsData.filter((a) => a.type === "soundtrack");

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Enya Albums & Discography",
  "description": description,
  "itemListElement": albumsData.map((album, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "MusicAlbum",
      "name": album.title,
      "datePublished": album.year,
      "byArtist": {
        "@type": "MusicGroup",
        "name": "Enya"
      }
    }
  }))
};
---

<Layout {title} {description} {canonical} {ogImage} {bodyClass} {schemaJson}>
  <div id="content">
    <nav aria-label="Breadcrumb">
      <ol id="breadcrumb">
        <li><a href="/">Home</a> &rsaquo;</li>
        <li><strong>Enya Songs &amp; Albums</strong></li>
      </ol></nav> </nav>

    <main id="main" class="discography">
      <div id="holidays2025">
        <h2><em>Holidays with Enya</em></h2>
        <a href="https://amzn.to/4okO9eR" target="_blank" rel="nofollow sponsored noopener">
          <img src="/ecs.jpg" alt="Christmas Secrets album cover" width="150" height="150" />
          <p><em><strong>Christmas Secrets</strong></em><br /> The ultimate compilation</p>
        </a>

        <a href="https://amzn.to/43aGdVb" target="_blank" rel="nofollow sponsored noopener">
          <img src="/awc.jpg" alt="And Winter Came album cover" width="150" height="150" />
          <p><em><strong>And Winter Came...</strong></em><br /> A winter-themed album</p>
        </a>

        <a href="https://amzn.to/4hEQ7nG" target="_blank" rel="nofollow sponsored noopener">
          <img src="/vbe.jpg" alt="The Very Best of Enya album cover" width="150" height="150" />
          <p><em><strong>The Very Best of Enya</strong></em><br /> The perfect gift</p>
        </a>
      </div>

      <h1>All of Enya's music: full album list, soundtracks</h1>

      <p>
        <strong>Dive into Enya's complete discography</strong>: Explore all her albums, renowned for their captivating melodies and insightful lyrics. Our <a href="/all-enya-songs">comprehensive song list</a> helps you find any track effortlessly.
      </p>

      <h2>Enya's studio albums and compilations</h2>

      <div class="album-grid">
        {mainAlbums.map((album) => (
          <article class="album-card">
            <div class="album-cover">
              {album.link ? (
                <a href={album.link}>
                  <img src={album.cover} alt={`${album.title} album cover`} width="150" height="150" />
                </a>
              ) : (
                <img src={album.cover} alt={`${album.title} album cover`} width="150" height="150" />
              )}
            </div>
            <div class="album-details">
              <h3>
                {album.link ? (
                  <a href={album.link}><strong>{album.title}</strong>{album.year ? `, ${album.year}` : ''}</a>
                ) : (
                  <span><strong>{album.title}</strong>{album.year ? `, ${album.year}` : ''}</span>
                )}
              </h3>
              <p>{album.description}</p>
              {album.buyLink && (
                <p>
                  <a href={album.buyLink} target="_blank" rel="nofollow sponsored noopener" class="buy-btn">
                    Stream / Buy on Amazon
                  </a>
                </p>
              )}
            </div>
          </article>
        ))}
      </div>

      <h2 id="esoundtrack">Enya on TV and film soundtracks</h2>

      <div class="album-grid">
        {soundtrackAlbums.map((album) => (
          <article class="album-card">
            <div class="album-cover">
              <img src={album.cover} alt={`${album.title} cover`} width="150" height="150" />
            </div>
            <div class="album-details">
              <h3>
                {album.link ? (
                  <a href={album.link}><strong>{album.title}</strong>{album.year ? `, ${album.year}` : ''}</a>
                ) : (
                  <span><strong>{album.title}</strong>{album.year ? `, ${album.year}` : ''}</span>
                )}
              </h3>
              <p>{album.description}</p>
            </div>
          </article>
        ))}
      </div>
    </main>

    <aside id="sidebar">
      <p><strong>Looking for downloads?</strong> <a href="https://amzn.to/1N3fScO" rel="nofollow sponsored noopener" target="_blank">Get all Enya MP3 downloads</a> on Amazon now!</p>

      <h3>Featured Album</h3>
      <div>
        <a href="/and-winter-came">
          <img src="/awc.jpg" alt="And Winter Came... album cover" width="150" height="150" />
        </a>
        <p>
          <strong><em><a href="/and-winter-came">And Winter Came...</a></em></strong><br />
          Released in 2008, this album primarily has a Christmas or winter theme.
        </p>
      </div>
    </aside>
  </div>
</Layout>

<style>
  .album-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }
  .album-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid #eaeaea;
    border-radius: 8px;
    background: #fff;
  }
  .album-cover img {
    border-radius: 4px;
    object-fit: cover;
  }
  .album-details h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }
  .buy-btn {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    font-size: 0.85rem;
    background-color: #f0c14b;
    border: 1px solid #a88734;
    border-radius: 3px;
    color: #111;
    text-decoration: none;
  }
  .buy-btn:hover {
    background-color: #ddb347;
  }
</style>
