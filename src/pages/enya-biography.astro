---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import faqData from "../data/biography-faq.json";
import liveData from "../data/biography-live.json";

const title = "Enya biography, trivia and FAQ | Enya Lyrics, MP3 downloads";
const description = "Enya biography, trivia and frequently asked questions. Enya Lyrics is a tribute to singer Enya featuring all her song lyrics, downloads, Only Time info, albums information, videos, biography and more!";
const canonical = "https://www.enyaone.com/enya-biography";
const ogImage = "https://www.enyaone.com/enya-promo.jpg";
const bodyClass = "biography-page";

const schemaJson = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"name": title,
	"description": description,
  "mainEntity": {
    "@type": "Person",
    "name": "Enya",
    "alternateName": "Eithne Pádraigín Ní Bhraonáin",
    "birthDate": "1961-05-17",
    "birthPlace": "Gweedore, County Donegal, Ireland"
  }
};
---

<Layout {title} {description} {canonical} {ogImage} {bodyClass} {schemaJson}>
  <div id="content">
    <nav aria-label="Breadcrumb">
      <ol id="breadcrumb">
        <li><a href="/">Home</a> &rsaquo;</li>
        <li><strong>Enya biography</strong></li>
      </ol></nav> </nav>

    <main id="main" class="biography">
      <h1>Enya Biography &amp; FAQ</h1>

      <p><strong>Enya</strong> (born Eithne Pádraigín Ní Bhraonáin on 17 May 1961) is an Irish singer, songwriter, and musician. Born into a musical family and raised in the Irish-speaking region of Gweedore, she began her musical career with her family's Celtic band Clannad in 1980 before leaving to pursue a solo career.</p>

      <h2>Frequently Asked Questions (FAQ)</h2>
      <dl class="faq-list">
        {faqData.map((item) => (
          <div class="faq-item">
            <dt><strong>{item.question}</strong></dt>
            <dd>{item.answer}</dd>
          </div>
        ))}
      </dl>

      <h2>Notable Live Performances</h2>
      <ul class="live-list">
        {liveData.map((perf) => (
          <li>
            <strong>{perf.title}</strong> ({perf.date}) &ndash; <em>{perf.location}</em>
            <p>{perf.description}</p>
          </li>
        ))}
      </ul>
    </main>

    <Sidebar />
  </div>
</Layout>

<style>
  .faq-list {
    margin: 1.5rem 0;
  }
  .faq-item {
    margin-bottom: 1.25rem;
  }
  .faq-item dt {
    font-size: 1.1rem;
    color: #222;
  }
  .faq-item dd {
    margin-left: 0;
    margin-top: 0.25rem;
    color: #444;
  }
  .live-list {
    margin: 1.5rem 0;
    padding-left: 1.2rem;
  }
  .live-list li {
    margin-bottom: 1rem;
  }
</style>
