---
import Layout from "../layouts/Layout.astro";

const title = "Our recommended links | Enya fan sites";
const description = "More Enya official and fan site links. Enya Lyrics is a tribute to the New Age singer Enya featuring all her song lyrics, MP3 downloads, Only Time info, discography, news, videos, quotes, biography and more!";
const canonical = "https://www.enyaone.com/enya-links";
const ogImage = "https://www.enyaone.com/enya-promo.jpg";
const bodyClass = "";

const schemaJson = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"name": title,
	"description": description
};
---

<Layout {title} {description} {canonical} {ogImage} {bodyClass} {schemaJson}>

